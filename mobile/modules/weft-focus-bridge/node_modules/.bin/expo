else
  export NODE_PATH="/Users/shravanthks/WEFT/mobile/node_modules/.pnpm/expo@56.0.21_@babel+core@7.29.7_supports-color@8.1.1__@expo+dom-webview@56.0.6_@expo+me_603a88d762b40390604488f1376b2a38/node_modules/expo/node_modules:/Users/shravanthks/WEFT/mobile/node_modules/.pnpm/expo@56.0.21_@babel+core@7.29.7_supports-color@8.1.1__@expo+dom-webview@56.0.6_@expo+me_603a88d762b40390604488f1376b2a38/node_modules:/Users/shravanthks/WEFT/mobile/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../expo/bin/cli" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../expo/bin/cli" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../expo/bin/cli" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../expo/bin/cli" "$@"
else
  exec node  "$basedir/../expo/bin/cli" "$@"
fi
