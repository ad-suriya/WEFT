<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

  <!-- Android 11+ package-visibility: the officially-supported exemption for a "choose apps to
       block" picker is an intent-pattern query, not naming individual packages or requesting
       QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".WeftBlockAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true"
      android:label="WEFT Focus Blocking">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/weft_block_accessibility_config" />
    </service>
  </application>
</manifest>
